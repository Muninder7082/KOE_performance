# =====================================================================
# Website Performance Monitor — configuration
# Local: copy to .env.  Hugging Face: add each value under
# Space -> Settings -> Variables and secrets (use "Secret" for secrets).
# =====================================================================

# ---- Required secrets ------------------------------------------------
# PostgreSQL (Neon / Supabase / Render / any). sslmode=require is supported.
DATABASE_URL=postgresql://monitor:monitor@db:5432/monitor
# Random 32+ character strings, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
SCHEDULER_TOKEN=change-me-to-another-long-random-string-32-chars
# Google Cloud -> APIs & Services -> enable "PageSpeed Insights API" -> Credentials -> API key
PAGESPEED_API_KEY=

# ---- First administrator (created only when no users exist) -----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-10-chars

# ---- Time --------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata

# ---- E-mail ------------------------------------------------------------
# smtp | brevo | sendgrid | resend | disabled   (brevo/sendgrid/resend use HTTPS: use them when SMTP ports are blocked, e.g. Render free)
EMAIL_PROVIDER=smtp
EMAIL_FROM=monitor@yourdomain.com
EMAIL_FROM_NAME=Website Performance Monitor
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# HTTPS e-mail APIs (use if the Space cannot reach SMTP ports)
BREVO_API_KEY=
SENDGRID_API_KEY=
RESEND_API_KEY=
# Default recipients (comma separated) — editable later in Settings
REPORT_EMAILS=
ALERT_EMAILS=

# ---- Excel workbook storage -----------------------------------------------
# local (HF persistent storage at /data, or a Docker volume) | hf_dataset | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data
# Set to true when LOCAL_STORAGE_DIR is a Docker volume (outside Hugging Face)
STORAGE_LOCAL_IS_PERSISTENT=false
EXCEL_FILENAME=website-performance.xlsx
# hf_dataset: private dataset repo + a token with WRITE access
HF_TOKEN=
HF_DATASET_REPO=your-username/website-performance-data
HF_DATASET_PATH=
# s3: AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT_URL=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Scheduling ------------------------------------------------------------
# Built-in timer while the Space is awake (the external scheduler is still recommended)
ENABLE_INTERNAL_SCHEDULER=true
# Sleep-friendly hosting (Render free): wake 20 min before each run, sleep after the report.
# cron-job.org -> Settings -> API: create an API key; the job id is in the job's edit URL.
CRONJOB_API_KEY=
CRONJOB_JOB_ID=
KEEP_ALIVE_ENABLED=true
INTERNAL_SCHEDULER_INTERVAL_SECONDS=60
# A missed run (e.g. Space was asleep) still runs if detected within this many hours
SCHEDULE_CATCHUP_HOURS=6

# ---- PageSpeed tuning --------------------------------------------------------
PAGESPEED_CONCURRENCY=3
PAGESPEED_TIMEOUT_SECONDS=150
PAGESPEED_MAX_RETRIES=3
MANUAL_TEST_COOLDOWN_SECONDS=120

# ---- Web / security -----------------------------------------------------------
# Public URL of the app, used for links in e-mails, e.g. https://you-monitor.hf.space
PUBLIC_BASE_URL=
COOKIE_SECURE=true
# lax (recommended; open the *.hf.space URL directly) | none (works inside the HF iframe) | strict
COOKIE_SAMESITE=lax
SESSION_HOURS=12
# Reverse proxies in front of the app (1 on Hugging Face; 0 if the container is exposed directly)
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=INFO
ENVIRONMENT=production
